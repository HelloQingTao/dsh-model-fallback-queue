{
  "name": "dsh-model-fallback-queue",
  "version": "0.2.1",
  "description": "模型故障转移队列：P1 限额/限流/不可用时自动切到队列下一个模型继续，全部图形界面配置 | Model fallback queue for DeepSeek Harness: auto-switch to the next model when the current one hits quota or rate limits",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "assets",
    "docs/design-plan.md",
    "state.js"
  ],
  "license": "MIT",
  "author": "HelloQingTao",
  "homepage": "https://github.com/HelloQingTao/dsh-model-fallback-queue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloQingTao/dsh-model-fallback-queue.git"
  },
  "bugs": {
    "url": "https://github.com/HelloQingTao/dsh-model-fallback-queue/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-failover",
    "failover",
    "fallback",
    "circuit-breaker",
    "quota",
    "rate-limit",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5-alpha.1",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-atomic-write": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": [
        "0.2.0-rc.2",
        "0.2.1-rc.2"
      ]
    }
  }
}
